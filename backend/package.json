{
  "name": "sku-generator-backend",
  "version": "1.0.0",
  "description": "SKU Generator WebApp - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node database/migrations/run-migration.js",
    "seed:brands": "node database/seeds/seed_brands.js",
    "seed:all": "node database/seeds/seed_brands.js && node database/seeds/seed_item_types.js && node database/seeds/seed_ports.js && node database/seeds/seed_uoms.js && node database/seeds/seed_pics.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
